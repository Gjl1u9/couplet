{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "extension-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const{createServer:c}=require('http'),f=require('fs'),p=require('path');const d='/Users/andrew/Documents/dual-subtitles';const t={'.html':'text/html;charset=utf-8','.css':'text/css'};c((q,r)=>{const n=p.normalize(q.url.split('?')[0]);f.readFile(p.join(d,n),(e,b)=>{if(e){r.writeHead(404);r.end();return}r.writeHead(200,{'content-type':t[p.extname(n)]||'text/plain'});r.end(b)})}).listen(Number(process.env.PORT)||4173,'127.0.0.1')"
      ],
      "port": 4173
    },
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const{createServer:c}=require('http'),f=require('fs'),p=require('path');const d='/Users/andrew/Documents/dual-subtitles/site/public';const t={'.html':'text/html;charset=utf-8','.css':'text/css','.png':'image/png'};c((q,r)=>{let n=p.normalize(q.url.split('?')[0]);if(n.endsWith('/'))n+='index.html';f.readFile(p.join(d,n),(e,b)=>{if(e){r.writeHead(404);r.end();return}r.writeHead(200,{'content-type':t[p.extname(n)]||'text/plain'});r.end(b)})}).listen(Number(process.env.PORT)||4175,'127.0.0.1')"
      ],
      "port": 4175
    }
  ]
