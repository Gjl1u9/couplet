{
  "manifest_version": 3,
  "name": "YouTube Event Recorder (dev)",
  "version": "0.1.0",
  "description": "開發用：記錄 YouTube 的事件時序，不記錄帳號資料。",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Event Recorder"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
